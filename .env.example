# Copy this file to .env and fill in what you need. .env is gitignored.

# --- Required ------------------------------------------------------------------
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# --- Optional: send real summary emails via https://resend.com -------------------
# Without a verified domain, Resend only delivers to your own account email,
# so for the demo send every summary email to your inbox with RECEIPT_TO_OVERRIDE.
# RESEND_API_KEY=
# RECEIPT_FROM=Talk to My Agent <onboarding@resend.dev>
# RECEIPT_TO_OVERRIDE=you@example.com
# RECEIPT_ALLOWED_DOMAINS=
# BRIEFING_TO=you@example.com

# --- Optional: send the job seeker's phone notification via Telegram --------------
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Optional: limits for a public demo URL ---------------------------------------
# MAX_CALL_SECONDS=600
# TOKENS_PER_IP_PER_HOUR=20
